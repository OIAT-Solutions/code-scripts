# Runtime profile
STATE_ROOT=runtime
OIAT_COMPANIES_DIR=runtime/code_scripts/companies
OIAT_RUNTIME_ENV=production

# QuickBooks Online App Credentials
# Production should use your Intuit Production app.
# Local sandbox/staging should use your Intuit Development app.
QBO_CLIENT_ID=your_client_id_here
QBO_CLIENT_SECRET=your_client_secret_here
# Intuit Webhooks "verifier token" for validating intuit-signature headers.
QBO_WEBHOOK_VERIFIER_TOKEN=your_intuit_webhook_verifier_token

# Django deployment settings
# Required when running with Docker / gunicorn
# Wrap in single quotes if the value contains `$` so Docker Compose does not try to interpolate it.
DJANGO_SECRET_KEY='replace-with-a-long-random-secret'
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-server-ip,your-domain.com
# Set this when serving the app behind HTTPS
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com
DJANGO_USE_X_FORWARDED_PROTO=1
DJANGO_USE_X_FORWARDED_HOST=1
# Leave these at 1 behind HTTPS. Set to 0 only for plain HTTP testing.
DJANGO_CSRF_COOKIE_SECURE=1
DJANGO_SESSION_COOKIE_SECURE=1

# Caddy reverse proxy / tailnet-only access
PORTAL_DOMAIN=portal.oiatsolutions.com
TAILSCALE_BIND_IP=100.125.133.118
# Cloudflare API token scoped to the portal zone with:
# - Zone.Zone:Read
# - Zone.DNS:Edit
CF_API_TOKEN=your_cloudflare_dns_api_token

# Cloudflare Tunnel token for the cloudflared service (public inbound-webhook ingress).
# The portal stays tailnet-only; this tunnel exposes ONLY the QBO webhook path on a
# dedicated public hostname (e.g. qbo-webhooks.oiatsolutions.com) so Intuit can reach it.
# Create the tunnel in Cloudflare Zero Trust > Networks > Tunnels, add a Public Hostname
# routed to http://web:8000 with Path = epos-qbo/webhooks/quickbooks , then paste its token here.
# Remember to add the webhook hostname (e.g. qbo-webhooks.oiatsolutions.com) to
# DJANGO_ALLOWED_HOSTS above, since cloudflared forwards that Host header to Django.
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token

# Public webhook URL shown on the portal Settings page and registered in Intuit.
# Set this to the tunnel hostname (bare host or full URL) when the public webhook
# endpoint differs from the tailnet-only portal domain. Falls back to PORTAL_DOMAIN.
QBO_WEBHOOK_PUBLIC_URL=qbo-webhooks.your-domain.com

# Public base URL for website log ingestion endpoints, exposed through a narrow
# Cloudflare Tunnel hostname while the dashboard itself remains tailnet-only.
WEBSITE_LOGS_PUBLIC_BASE_URL=https://website-logs.your-domain.com

# Company A (AKPONORA VENTURES LTD.) EPOS Credentials
EPOS_USERNAME_A=your_company_a_epos_username
EPOS_PASSWORD_A=your_company_a_epos_password

# Company B (GOLDPLATES FEASTHOUSE LTD.) EPOS Credentials
EPOS_USERNAME_B=your_company_b_epos_username
EPOS_PASSWORD_B=your_company_b_epos_password

# Company A (AKPONORA VENTURES LTD.) Slack Webhook (optional)
# Referenced by code_scripts/companies/company_a.json as SLACK_WEBHOOK_URL_A.
SLACK_WEBHOOK_URL_A=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Company B (GOLDPLATES FEASTHOUSE LTD.) Slack Webhook (optional)
# Referenced by code_scripts/companies/company_b.json as SLACK_WEBHOOK_URL_B.
SLACK_WEBHOOK_URL_B=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# QuickBooks webhook Slack destinations (separate from pipeline Slack webhooks).
# The company-specific value wins; QBO_WEBHOOK_SLACK_URL is an optional fallback.
QBO_WEBHOOK_SLACK_URL_COMPANY_A=https://hooks.slack.com/services/YOUR/QBO/WEBHOOK
QBO_WEBHOOK_SLACK_URL_COMPANY_B=
QBO_WEBHOOK_SLACK_URL_TEST=
QBO_WEBHOOK_SLACK_URL=

# Note: QBO_REALM_ID is no longer needed here - it's now in companies/company_a.json and companies/company_b.json
# Note: The .env.gp file is no longer needed - all credentials are now in this single .env file

# Scheduler worker: the one scheduler. Schedules are rows on the portal Schedules page
# (Daily routine for Akponora, Sales sync for the other companies); there is no env schedule.
OIAT_SCHEDULER_POLL_SECONDS=15

# Company A (Akponora) unattended October+ posting. Leave unset until the owner approves.
# Both must be set for standing auto-approval (see docs/AKPONORA_POSTING_CONTROLS.md,
# "Unattended daily operation (standing approval)"). Optional cap on the day's EPOS gross (naira).
# OIAT_COMPANY_A_SALES_AUTOMATION_ENABLED=1
# OIAT_COMPANY_A_STANDING_APPROVAL_REF=owner standing approval, <date>, <chat reference>
# OIAT_COMPANY_A_AUTO_APPROVAL_MAX_GROSS=15000000

# Company A Daily routine (docs/SERVER_SETUP.md). The scheduler container runs it from the
# "Nora daily routine" schedule (on/off and time on the Schedules page): catalogue sync ->
# vendors + bills from EPOS POs -> sales (standing approval above) -> item guard -> stock -> deposits.
# Every switch below is a chat-yes action.
# OIAT_COMPANY_A_DAILY_RUN_LOCK_WAIT_MINUTES=30
# OIAT_AKPONORA_OPS_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/OPS/WEBHOOK
# Catalogue: create qty-0 items + install mapping for new EPOS products (capped)
# OIAT_COMPANY_A_CATALOGUE_AUTO_CREATE=1
# OIAT_COMPANY_A_CATALOGUE_APPROVAL_REF=owner approval, <date>, <chat reference>
# OIAT_COMPANY_A_CATALOGUE_AUTO_MAX_CREATES=25
# Vendors: create genuinely new EPOS PO suppliers in QBO (near matches always wait for review)
# OIAT_COMPANY_A_VENDOR_AUTO_CREATE=1
# OIAT_COMPANY_A_VENDOR_APPROVAL_REF=owner approval, <date>, <chat reference>
# OIAT_COMPANY_A_VENDOR_AUTO_MAX=5
# Bills: post READY unpaid bills from received EPOS POs (capped; never pays)
# OIAT_COMPANY_A_BILLS_AUTO_POST=1
# OIAT_COMPANY_A_BILLS_APPROVAL_REF=owner approval, <date>, <chat reference>
# OIAT_COMPANY_A_BILLS_AUTO_MAX_BILL=2000000
# OIAT_COMPANY_A_BILLS_AUTO_MAX_COUNT=20
# Undeposited Funds report placeholder (report only, never deposits)
# OIAT_COMPANY_A_UF_DEPOSIT_ENABLED=0

